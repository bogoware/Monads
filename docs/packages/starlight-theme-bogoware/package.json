      "optional": true
    }
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.30.0",
    "astro": "^5.17.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "index.ts",
    "schema.ts",
    "styles/",
    "overrides/",
    "components/",
