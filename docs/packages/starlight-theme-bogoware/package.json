{
  "name": "@bogoware/starlight-theme",
  "version": "0.1.1",
  "type": "module",
  "description": "Bogoware brand identity theme for Astro Starlight documentation sites",
  "license": "MIT",
  "author": "Bogoware",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bogoware/Monads.git",
    "directory": "docs/packages/starlight-theme-bogoware"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
