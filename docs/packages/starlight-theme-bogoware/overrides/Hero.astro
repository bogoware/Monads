---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Hero.astro';
import FieldLines from '../components/FieldLines.astro';
---

<div class="bw-hero-wrapper">
  <FieldLines />
  <div class="bw-hero-content">
    <Default {...Astro.props}><slot /></Default>
  </div>
</div>

<style>
  .bw-hero-wrapper {
    position: relative;
    overflow: hidden;
  }
  .bw-hero-content {
    position: relative;
    z-index: 1;
  }
</style>
