---
/**
 * Google Analytics 4 component with privacy-respecting defaults.
 *
 * Supports:
 * - Do Not Track (DNT) header respect (enabled by default)
 * - Cookieless mode for GDPR compliance
 * - Conditional loading — no script injected without a measurement ID
 *
 * Typically injected via the plugin's `addIntegration` hook rather than
 * used directly in templates.
 */
export interface Props {
  measurementId?: string;
  respectDnt?: boolean;
  cookieless?: boolean;
}

const { measurementId, respectDnt = true, cookieless = false } = Astro.props;
---

{measurementId && (
  <script is:inline define:vars={{ id: measurementId, respectDnt, cookieless }}>
    (function() {
      if (respectDnt && navigator.doNotTrack === '1') return;
      var s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
      s.async = true;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', id, cookieless ? { client_storage: 'none', anonymize_ip: true } : {});
    })();
  </script>
)}
