---
export interface Props {
  variant?: 'full' | 'simplified' | 'monochrome';
  size?: number | string;
  class?: string;
}

const { variant = 'full', size = 32, class: className = '' } = Astro.props;
---

{variant === 'full' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"
       width={size} height={size} class={className} role="img" aria-label="Bogoware">
    <defs>
      <linearGradient id="bw-g1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#6366f1"/>
        <stop offset="100%" stop-color="#8b5cf6"/>
      </linearGradient>
      <linearGradient id="bw-g2" x1="100%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" stop-color="#99f0ff"/>
        <stop offset="100%" stop-color="#b0a0ff"/>
      </linearGradient>
      <radialGradient id="bw-bg">
        <stop offset="0%" stop-color="#1e293b"/>
        <stop offset="100%" stop-color="#0f172a"/>
      </radialGradient>
    </defs>
    <rect x="8" y="8" width="184" height="184" rx="36" ry="36"
          fill="url(#bw-bg)" stroke="#818cf8" stroke-opacity="0.35" stroke-width="1.5"/>
    <path d="M 24,24 C 68,24 51,84 96,96 C 141,108 124,168 168,168"
          fill="none" stroke="#6366f1" stroke-width="1.8" opacity="0.1" stroke-linecap="round"/>
    <path d="M 32,32 C 76,32 59,92 104,104 C 149,116 132,176 176,176"
          fill="none" stroke="#8b5cf6" stroke-width="1.8" opacity="0.08" stroke-linecap="round"/>
    <path d="M 176,24 C 132,24 149,84 104,96 C 59,108 76,168 32,168"
          fill="none" stroke="#99f0ff" stroke-width="1.8" opacity="0.1" stroke-linecap="round"/>
    <path d="M 168,32 C 124,32 141,92 96,104 C 51,116 68,176 24,176"
          fill="none" stroke="#b0a0ff" stroke-width="1.8" opacity="0.08" stroke-linecap="round"/>
    <path d="M 28,28 C 72,28 55,88 100,100 C 145,112 128,172 172,172"
          fill="none" stroke="url(#bw-g1)" stroke-width="5" stroke-linecap="round"/>
    <path d="M 172,28 C 128,28 145,88 100,100 C 55,112 72,172 28,172"
          fill="none" stroke="url(#bw-g2)" stroke-width="5" stroke-linecap="round"/>
    <circle cx="100" cy="100" r="7" fill="white"/>
  </svg>
)}

{variant === 'simplified' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"
       width={size} height={size} class={className} role="img" aria-label="Bogoware">
    <defs>
      <linearGradient id="bw-sg1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#6366f1"/>
        <stop offset="100%" stop-color="#8b5cf6"/>
      </linearGradient>
      <linearGradient id="bw-sg2" x1="100%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" stop-color="#99f0ff"/>
        <stop offset="100%" stop-color="#b0a0ff"/>
      </linearGradient>
      <radialGradient id="bw-sbg">
        <stop offset="0%" stop-color="#1e293b"/>
        <stop offset="100%" stop-color="#0f172a"/>
      </radialGradient>
    </defs>
    <rect x="8" y="8" width="184" height="184" rx="36" ry="36"
          fill="url(#bw-sbg)" stroke="#818cf8" stroke-opacity="0.35" stroke-width="2"/>
    <path d="M 28,28 C 72,28 55,88 100,100 C 145,112 128,172 172,172"
          fill="none" stroke="url(#bw-sg1)" stroke-width="8" stroke-linecap="round"/>
    <path d="M 172,28 C 128,28 145,88 100,100 C 55,112 72,172 28,172"
          fill="none" stroke="url(#bw-sg2)" stroke-width="8" stroke-linecap="round"/>
    <circle cx="100" cy="100" r="10" fill="white"/>
  </svg>
)}

{variant === 'monochrome' && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"
       width={size} height={size} class={className} role="img" aria-label="Bogoware">
    <path d="M 28,28 C 72,28 55,88 100,100 C 145,112 128,172 172,172"
          fill="none" stroke="#818cf8" stroke-width="5" stroke-linecap="round"/>
    <path d="M 172,28 C 128,28 145,88 100,100 C 55,112 72,172 28,172"
          fill="none" stroke="#818cf8" stroke-width="5" stroke-linecap="round" stroke-dasharray="12,6"/>
    <circle cx="100" cy="100" r="7" fill="#818cf8"/>
  </svg>
)}
