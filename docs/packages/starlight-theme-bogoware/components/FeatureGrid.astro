---
export interface Props {
  columns?: 2 | 3 | 4;
}
const { columns = 3 } = Astro.props;
---

<div class="bw-feature-grid" style={`--cols: ${columns}`}>
  <slot />
</div>

<style>
  .bw-feature-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: var(--bw-space-4, 16px);
    margin: var(--bw-space-8, 32px) 0;
  }
  @media (max-width: 768px) {
    .bw-feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
