---
export interface Props {
  class?: string;
  opacity?: number;
}
const { class: className = '', opacity = 0.06 } = Astro.props;
---

<div class:list={['field-lines', className]} aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">
    <defs>
      <linearGradient id="fl-g1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#6366f1"/>
        <stop offset="100%" stop-color="#8b5cf6"/>
      </linearGradient>
      <linearGradient id="fl-g2" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#99f0ff"/>
        <stop offset="100%" stop-color="#b0a0ff"/>
      </linearGradient>
    </defs>
    <!-- Sweeping field lines across the hero -->
    <path d="M 0,150 C 200,100 300,200 400,200 C 500,200 600,100 800,150" fill="none" stroke="url(#fl-g1)" stroke-width="2" opacity={opacity}/>
    <path d="M 0,250 C 200,300 300,200 400,200 C 500,200 600,300 800,250" fill="none" stroke="url(#fl-g2)" stroke-width="2" opacity={opacity}/>
    <path d="M 0,180 C 200,130 280,220 400,220 C 520,220 600,130 800,180" fill="none" stroke="url(#fl-g1)" stroke-width="1.5" opacity={opacity * 0.7}/>
    <path d="M 0,220 C 200,270 280,180 400,180 C 520,180 600,270 800,220" fill="none" stroke="url(#fl-g2)" stroke-width="1.5" opacity={opacity * 0.7}/>
    <!-- Concentric arcs from center (gravitational wave effect) -->
    <circle cx="400" cy="200" r="80" fill="none" stroke="#818cf8" stroke-width="0.5" opacity={opacity * 0.5}/>
    <circle cx="400" cy="200" r="140" fill="none" stroke="#818cf8" stroke-width="0.5" opacity={opacity * 0.3}/>
    <circle cx="400" cy="200" r="200" fill="none" stroke="#818cf8" stroke-width="0.5" opacity={opacity * 0.2}/>
  </svg>
</div>

<style>
  .field-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
</style>
